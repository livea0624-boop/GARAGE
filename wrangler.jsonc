{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garage-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "GARAGE_DB",
      "database_name": "garage-cloud-db",
      "database_id": "caeb6602-b29b-4b52-9820-485a4c9504e5"
    }
  ]
}
